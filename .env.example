# ── Required API Keys ────────────────────────────────────────────────────────
# Basic RAG engine (Mistral Large LLM)
MISTRAL_API_KEY=your_mistral_api_key_here

# Gemini models and Groq fallbacks
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_API_KEY2=your_google_api_key2_here

# Google Identity Services Web application client ID. Required when AUTH_REQUIRED=true.
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
AUTH_REQUIRED=true
# Owner-only dashboard access. Use a comma-separated list only if you add more administrators.
ADMIN_EMAILS=jugalganeshboddu@gmail.com

# Optional model/version overrides
APP_VERSION=2.5
GOOGLE_LLM=gemini-3.1-flash-lite-preview
GEMINI_LLM=gemini-2.5-flash
GROQ_SUBQUESTION_LLM=qwen/qwen3.6-27b
GROQ_ROUTER_LLM=qwen/qwen3.6-27b

# Legacy Gemma key/model, kept only if you experiment with older engine settings
GOOGLE_API_KEY_GEMMA=your_gemma_api_key_here
GOOGLE_GEMMA_LLM=gemma-4-26b-a4b-it

# Router classification and Sub-Question decomposition (Groq / Qwen3.6-27b)
GROQ_API_KEY=your_groq_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Multi-Document Agent reranking (optional)
COHERE_API_KEY=your_cohere_api_key_here

# Flask session encryption key (auto-generated if omitted)
FLASK_SECRET_KEY=your_random_secret_key_here

# Remote Mistral embedding performance tuning. Larger batches use more API capacity.
MISTRAL_EMBED_MODEL=mistral-embed
CHUNK_SIZE=512
CHUNK_OVERLAP=64
EMBED_BATCH_SIZE=32
PRELOAD_EMBED_MODEL=true
ANSWER_MAX_TOKENS=4096
GROQ_CONTEXT_WINDOW=131072
